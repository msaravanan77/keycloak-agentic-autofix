# Amazon Bedrock long-term API key (bearer token). Short-term keys expire in <=12h.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-long-term-api-key
AWS_REGION=us-east-1

# Optional now, required for the PR agent. Also raises the GitHub API rate limit
# for the bug scanner from 10 req/min (unauthenticated) to 30 req/min.
GITHUB_TOKEN=your-github-token
